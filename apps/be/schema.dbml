// BoughtIT(벗잇) DB 설계 초안
// 작성 기준: apps/fe/ROUTES.md, apps/fe/templates, 시안 최종안(통합안, 경매·구해요 시안)
// 사용법: https://dbdiagram.io 편집기에 전체를 복사해 넣는다.

Project boughtit {
  database_type: 'Firebase Realtime Database'
  Note: '''
    # BoughtIT (벗잇) DB 설계 초안

    이화인 중고거래 서비스. 저장소는 Firebase Realtime Database(NoSQL)이다.
    이 문서는 구조를 한눈에 보기 위해 관계형 표기(DBML)로 정리한 것이다.

    ## 읽는 방법
    - 테이블 하나는 Firebase의 최상위 노드 하나이다. 각 테이블 Note에 실제 경로를 적었다.
    - pk는 Firebase 노드의 키이다. "push 키"는 Firebase push()가 만든 자동 키이다.
    - Ref(외래 키)는 Firebase가 강제하지 않는다. BE 코드에서 직접 검증한다.
    - 날짜와 시각은 ISO 8601 문자열(예: 2026-11-20T15:00:00+09:00)로 저장한다.
    - enum은 문자열로 저장한다. 허용 값 검증은 BE 코드에서 한다.
    - "FE 필드" 표기는 템플릿이 사용하는 이름이다. 컬럼 이름은 가능한 한 FE 필드 이름과 같게 정했다.

    ## 범위
    - 필수 8페이지: users, products, product_places, product_slots, reviews, likes
    - 팀 특화 기능: auctions, bids, reservations, wanted_posts, wanted_places, offers, chat_rooms, chat_messages
  '''
}

// ─────────────────────────────────────────────
// Enum
// ─────────────────────────────────────────────

Enum product_kind {
  fixed [note: '가격 정해서 올리기. 판매자가 정한 가격에 판다']
  bid [note: '가격 제안 받기(경매). 가격 없이 올리고 마감 때 최고 제안을 보고 판매자가 결정한다']
}

Enum product_condition {
  "최상" [note: '거의 새것']
  "상" [note: '사용감 적음']
  "중" [note: '사용감 있음']
  "하" [note: '흠집·고장 있음']
}

Enum sale_status {
  sale [note: '판매중. 구매자가 약속을 신청할 수 있다']
  hold [note: '예약중. 약속이 확정된 상태이며 새 신청을 받지 않는다']
  done [note: '거래 완료. 상품 목록에서 제외하고 리뷰를 쓸 수 있다']
}

Enum building {
  "ECC"
  "중앙도서관"
  "학생문화관"
  "포스코관"
  "아산공학관"
  "조형예술관"
  "학관"
  "기숙사"
  "기타" [note: '교외 등. 상세 위치(detail)를 반드시 입력한다']
}

Enum auction_decision {
  pending [note: '판매자가 아직 결정하지 않음. 마감 전이거나, 마감 후 48시간 이내']
  accepted [note: '거래 확정. 최고 제안자와의 약속(reservations)을 생성한다']
  rejected [note: '거래 안 함. 판매자가 거절했거나 마감 후 48시간 동안 응답이 없음']
}

Enum reservation_state {
  pending [note: '수락 대기. 구매자가 신청했고 판매자가 아직 응답하지 않음']
  confirmed [note: '약속 확정. 판매자가 수락함']
  rejected [note: '거절함']
  done [note: '거래 완료. 구매자가 리뷰를 쓸 수 있다']
}

Enum reservation_source {
  reserve [note: '상품 상세의 약속 신청 (product_reserve)']
  auction [note: '경매에서 판매자가 최고 제안을 수락함']
  offer [note: '구해요에서 글쓴이가 제안을 고름']
}

Enum wanted_category {
  book [note: '도서']
  digital [note: '전자기기']
  dorm [note: '생활용품']
  etc [note: '기타']
}

Enum wanted_condition {
  like_new [note: '거의 새것만']
  light_use [note: '사용감 조금']
  any [note: '상태 상관없음']
}

Enum wanted_state {
  open [note: '구하는 중. 제안을 받을 수 있다']
  done [note: '구했어요. 글쓴이가 제안 하나를 골랐다']
}

Enum message_kind {
  user [note: '사용자가 보낸 메시지']
  system [note: '시스템 안내. 예: 판매자가 약속을 수락했어요']
}

// ─────────────────────────────────────────────
// 1. 회원
// ─────────────────────────────────────────────

Table users [headerColor: #2B4BF2] {
  id varchar [pk, note: '아이디. FE 필드 user_id. 로그인 후 session["id"]에 저장한다']
  pw_hash varchar [not null, note: '비밀번호의 SHA-256 해시(hashlib.sha256). FE 필드 password. 원문은 저장하지 않는다. 규칙: 영문과 숫자를 섞어 8자 이상']
  email varchar [not null, unique, note: '이화인 메일. ewhain.net 또는 ewha.ac.kr 도메인만 허용한다']
  phone varchar [null, note: '전화번호 (선택). 예: 010-0000-0000']
  created_at datetime [not null, note: '가입 시각']

  Note: '''
    Firebase 경로: /users/{id}

    - 회원가입 폼(auth_signup): user_id, password, password_confirm, email, auth_code, phone
    - password_confirm, auth_code는 검증에만 쓰고 저장하지 않는다.
    - 메일 인증 코드(auth_code) 발송과 확인은 구현 범위를 회의에서 정한다. 구현하면 코드와 만료 시각은 session에 저장한다.
    - 마이페이지 표시: id, email
  '''
}

// ─────────────────────────────────────────────
// 2. 상품
// ─────────────────────────────────────────────

Table products [headerColor: #2B4BF2] {
  name varchar [pk, note: '상품명. 키로 사용한다. new, reserve, done, like는 등록할 수 없다 (고정 경로와 겹친다)']
  seller varchar [not null, ref: > users.id, note: '판매자 아이디. 로그인한 사용자의 session["id"]']
  kind product_kind [not null, default: 'fixed', note: '가격 정하는 방식']
  price integer [null, note: '가격(원). kind=fixed이면 필수. kind=bid이면 null이고 목록에는 auctions.top_price를 보여 준다']
  address varchar [not null, note: '주소 (거래 기본 장소). product_places가 없을 때 장소 칩으로 사용한다']
  status product_condition [not null, note: '상품 상태. 판매 상태(sale_status)와 다른 값이다']
  description text [not null, note: '상세 설명. 사용 기간, 상태, 흠집 여부']
  img_path varchar [not null, note: '대표 사진 파일명. static/uploads/ 아래에 저장한다. FE 폼 필드는 picture (JPG, PNG, 5MB 이하)']
  sale_status sale_status [not null, default: 'sale', note: '판매 상태. 내 상품 관리(my_manage)에서 판매자가 변경한다']
  likes integer [not null, default: 0, note: '찜 수. likes 테이블의 행 수와 같게 유지한다 (찜 토글 때 함께 갱신)']
  created_at datetime [not null, note: '등록 시각. FE에는 date(예: 2026.10.06) 형식의 문자열로 넘긴다']

  indexes {
    seller [note: '마이페이지의 내 물건 탭, 리뷰 목록의 판매자 필터']
    (sale_status, kind) [note: '상품 목록 필터 (sale_status, kind 쿼리)']
    created_at [note: '상품 목록 최신순 정렬']
  }

  Note: '''
    Firebase 경로: /products/{name}

    - 상품 등록 폼(product_new): seller, name, price, address, status, description, picture
    - 상품 목록(product_list): sale_status=done인 상품은 제외한다. 쿼리 q, sort(new, like, low, high), sale_status, kind, price_min, price_max, page
    - 내 상품 관리(my_manage)에서 수정할 수 있는 값: name, price, description, sale_status
    - 주의: Firebase 키에는 . $ # [ ] / 문자를 쓸 수 없다. 상품명에 이 문자가 있으면 등록을 막거나 키를 인코딩해야 한다.
    - 주의: name을 수정하면 키가 바뀌므로 이 상품을 참조하는 모든 노드를 함께 옮겨야 한다. 수정 범위에서 name을 제외하는 방안을 검토한다.
  '''
}

Table product_places [headerColor: #2B4BF2] {
  product_name varchar [not null, ref: > products.name]
  idx integer [not null, note: '순번(0부터). 약속 신청 폼의 place 값']
  building building [not null, note: '건물']
  detail varchar [null, note: '상세 위치. 예: 8번 출구 앞. building=기타이면 필수']

  indexes {
    (product_name, idx) [pk]
  }

  Note: '''
    Firebase 경로: /products/{name}/places/{idx}

    판매자가 열어 둔 거래 가능 장소. FE에는 product.places = [{building, detail}, ...]로 넘긴다.
    같은 상품에 (building, detail)이 같은 장소를 두 번 추가할 수 없다.
  '''
}

Table product_slots [headerColor: #2B4BF2] {
  product_name varchar [not null, ref: > products.name]
  idx integer [not null, note: '순번(0부터). 약속 신청 폼의 slot 값']
  start_at datetime [not null, note: '거래 가능 시작 시각. 30분 단위']

  indexes {
    (product_name, idx) [pk]
  }

  Note: '''
    Firebase 경로: /products/{name}/slots/{idx}

    판매자가 열어 둔 거래 가능 시간. FE에는 product.slots = ['10.12 (월) 13:00', ...] 형식의 문자열 목록으로 넘긴다.
    등록 화면에서는 요일과 시간 칸(09:00부터 30분 단위)으로 고른다.
  '''
}

Table likes [headerColor: #2B4BF2] {
  user_id varchar [not null, ref: > users.id, note: '찜한 사용자']
  product_name varchar [not null, ref: > products.name, note: '찜한 상품']
  created_at datetime [not null]

  indexes {
    (user_id, product_name) [pk]
    product_name
  }

  Note: '''
    Firebase 경로: /likes/{user_id}/{product_name}

    - 찜 토글: 행을 추가하거나 삭제하고 products.likes를 함께 갱신한다.
    - 자기 상품은 찜할 수 없다.
    - 상품 상세의 liked, 마이페이지의 내 찜 탭에서 사용한다.
  '''
}

// ─────────────────────────────────────────────
// 3. 리뷰
// ─────────────────────────────────────────────

Table reviews [headerColor: #E8452C] {
  product_name varchar [pk, ref: - products.name, note: '리뷰를 쓴 상품의 상품명. 키로 사용한다. FE 필드 product_name']
  reviewer varchar [not null, ref: > users.id, note: '리뷰 작성자(구매자) 아이디. 로그인 상태이면 session["id"]']
  seller varchar [not null, ref: > users.id, note: '판매자 아이디. products.seller를 복사해 저장한다 (판매자별 리뷰 조회용)']
  rating integer [not null, check: `rating between 1 and 5`, note: '별점 1~5']
  title varchar [not null, note: '리뷰 제목']
  content text [not null, note: '리뷰 내용']
  photo varchar [null, note: '리뷰 사진 파일명 (선택). static/uploads/ 아래에 저장한다']
  created_at datetime [not null, note: '작성 시각. FE에는 2026.10.05 형식으로 넘긴다']

  indexes {
    seller [note: '리뷰 목록의 seller 쿼리, 판매자 평균 별점 계산']
    created_at
  }

  Note: '''
    Firebase 경로: /reviews/{product_name}

    - 리뷰 작성 폼(review_new): product_name, reviewer, rating, title, photo, content
    - 리뷰 상세 경로가 /review/<상품명>이므로 상품 하나에 리뷰는 하나이다.
    - 확인 필요: 리뷰를 쓸 수 있는 조건. 시안은 거래 완료(약속 state=done) 후 구매자만 쓴다. 필수 데모에서는 B가 A의 상품에 바로 리뷰를 쓰므로 조건을 완화할지 정한다 (#28).
    - 구해요 제안 목록의 별점은 seller 기준 rating 평균으로 계산한다.
  '''
}

// ─────────────────────────────────────────────
// 4. 약속
// ─────────────────────────────────────────────

Table reservations [headerColor: #59627E] {
  id varchar [pk, note: 'push 키']
  product_name varchar [null, ref: > products.name, note: '거래 상품. source=offer이면 null일 수 있다']
  wanted_id varchar [null, ref: > wanted_posts.id, note: 'source=offer일 때 구해요 글']
  seller varchar [not null, ref: > users.id, note: '판매자 아이디']
  buyer varchar [not null, ref: > users.id, note: '구매자 아이디']
  source reservation_source [not null, default: 'reserve', note: '약속이 만들어진 경로']
  place varchar [null, note: '약속 장소. 신청 당시의 "건물 상세 위치"를 복사해 저장한다. 경매와 구해요는 채팅에서 정하므로 null']
  meet_at datetime [null, note: '약속 시각. 신청 당시 고른 product_slots.start_at. 경매와 구해요는 null']
  price integer [not null, note: '거래 금액(원). 고정가, 낙찰가, 고른 제안 금액']
  state reservation_state [not null, default: 'pending']
  created_at datetime [not null, note: '신청 시각']
  decided_at datetime [null, note: '판매자가 수락하거나 거절한 시각']

  indexes {
    buyer [note: '마이페이지 약속 탭: 보낸 신청']
    seller [note: '마이페이지 약속 탭: 받은 신청']
    product_name
  }

  Note: '''
    Firebase 경로: /reservations/{id}

    - 약속 신청 폼(product_reserve): name(상품명), place(product_places.idx), slot(product_slots.idx)
    - 마이페이지 약속 탭: 진행 중(pending, confirmed)과 거래 완료(done)로 나눠 보여 준다.
    - 판매자가 수락하면 state=confirmed, products.sale_status=hold로 바꾼다.
    - 거래가 끝나면 state=done, products.sale_status=done으로 바꾼다.
    - source=auction, offer인 약속은 생성할 때부터 state=confirmed이다.
    - sale_status=hold 또는 done인 상품에는 새 약속을 신청할 수 없다.
  '''
}

// ─────────────────────────────────────────────
// 5. 경매 (가격 제안 받기)
// ─────────────────────────────────────────────

Table auctions [headerColor: #E8452C] {
  product_name varchar [pk, ref: - products.name, note: 'kind=bid인 상품의 상품명']
  duration_days integer [not null, check: `duration_days in (1, 3, 5, 7)`, note: '제안 받는 기간(일). 1, 3, 5, 7 중 하나']
  end_at datetime [not null, note: '마감 시각 = 등록 시각 + duration_days']
  top_price integer [not null, default: 0, note: '현재 최고 제안가(원). 제안이 없으면 0. 제안 등록 때 함께 갱신한다']
  bid_count integer [not null, default: 0, note: '제안 수. 제안 등록 때 함께 갱신한다']
  decision auction_decision [not null, default: 'pending', note: '마감 후 판매자의 결정']
  decided_at datetime [null, note: '판매자가 결정한 시각']

  Note: '''
    Firebase 경로: /auctions/{product_name}

    - 마감 판정: 스케줄러 없이 요청 시점에 현재 시각과 end_at을 비교한다.
    - 마감 후 48시간 동안 decision=pending이면 rejected로 처리한다 (같은 방식으로 요청 시점에 판정).
    - accepted: 최고 제안자와의 약속(reservations, source=auction)을 생성한다.
    - rejected 후 판매자의 선택: 다시 제안 받기(end_at을 다시 정하고 bids를 비운다) 또는 가격 정해서 다시 올리기(products.kind=fixed, price 입력).
    - top_price, bid_count는 목록 카드와 상세 화면에서 bids를 매번 세지 않기 위한 값이다.
  '''
}

Table bids [headerColor: #E8452C] {
  id varchar [pk, note: 'push 키']
  product_name varchar [not null, ref: > auctions.product_name, note: '제안한 경매 상품']
  bidder varchar [not null, ref: > users.id, note: '제안자 아이디. 마감 전에는 앞 두 글자만 보여 준다 (예: po***)']
  price integer [not null, note: '제안 금액(원)']
  created_at datetime [not null, note: '제안 시각']

  indexes {
    (product_name, price) [note: '제안 내역과 제안 순위 (금액 내림차순)']
    bidder
  }

  Note: '''
    Firebase 경로: /bids/{product_name}/{id}

    제안 등록 검증
    - 로그인해야 한다.
    - 자기 상품에는 제안할 수 없다.
    - 마감(end_at) 후에는 제안할 수 없다.
    - 금액은 auctions.top_price + 5,000원 이상이어야 한다. 첫 제안은 5,000원 이상이다.
    - 제안자 아이디 전체는 마감 후 판매자에게만 공개한다.
  '''
}

// ─────────────────────────────────────────────
// 6. 구해요
// ─────────────────────────────────────────────

Table wanted_posts [headerColor: #FFB800] {
  id varchar [pk, note: 'push 키']
  writer varchar [not null, ref: > users.id, note: '글쓴이 아이디']
  name varchar [not null, note: '찾는 물건. 예: 운영체제 공룡책 10판']
  category wanted_category [not null, default: 'etc', note: '분류. 목록 필터에 사용한다']
  budget integer [not null, check: `budget > 0`, note: '예산(원). 최대 금액이며 제안은 이 금액 이하만 가능하다']
  condition wanted_condition [not null, note: '괜찮은 상태']
  due_date date [not null, note: '필요한 날. 예: 2026-11-05']
  description text [null, note: '설명. 언제까지 필요한지, 확인하고 싶은 점']
  img_path varchar [null, note: '참고 사진 파일명(선택). static/uploads/ 아래에 저장. FE 폼 필드 picture']
  state wanted_state [not null, default: 'open']
  picked_offer_id varchar [null, ref: - offers.id, note: '글쓴이가 고른 제안. 고르면 state=done으로 바꾼다. 다시 고를 수 없다']
  offer_count integer [not null, default: 0, note: '받은 제안 수. 제안 등록 때 함께 갱신한다']
  created_at datetime [not null]

  indexes {
    (state, category) [note: '구해요 목록 필터']
    writer
  }

  Note: '''
    Firebase 경로: /wanted/{id}

    - 구해요 글쓰기(wanted_new): 찾는 물건, 예산, 괜찮은 상태, 필요한 날, 거래 장소(여러 개), 설명
    - 폼 필드와 저장 이름은 FE #61 화면과 같다(name, due_date, places).
    - 구해요 상세 경로의 파라미터는 id로 한다 (제목은 겹칠 수 있다).
  '''
}

Table wanted_places [headerColor: #FFB800] {
  wanted_id varchar [not null, ref: > wanted_posts.id]
  building building [not null, note: '거래 가능한 건물']

  indexes {
    (wanted_id, building) [pk]
  }

  Note: '''
    Firebase 경로: /wanted/{id}/places/{building}

    글쓴이가 고른 거래 장소. 여러 개를 고를 수 있다.
    저장은 /wanted/{id}/places에 {건물명: true} 형태. 화면에는 리스트로 넘긴다.
  '''
}

Table offers [headerColor: #FFB800] {
  id varchar [pk, note: 'push 키']
  wanted_id varchar [not null, ref: > wanted_posts.id, note: '제안을 보낸 구해요 글']
  seller varchar [not null, ref: > users.id, note: '제안자(물건을 가진 사람) 아이디']
  price integer [not null, note: '제안 금액(원). wanted_posts.budget 이하']
  description varchar [null, note: '물건 상태. 예: 3장까지 연필 필기, 표지 깨끗']
  place building [null, note: '거래 가능한 건물']
  img_path varchar [null, note: '제안 사진 파일명(선택). static/uploads/ 아래에 저장. FE 폼 필드 picture']
  created_at datetime [not null, note: '제안 시각']

  indexes {
    (wanted_id, price) [note: '받은 제안 목록 낮은 가격순']
    (wanted_id, created_at) [note: '받은 제안 목록 최신순']
    seller
  }

  Note: '''
    Firebase 경로: /offers/{wanted_id}/{id}

    - 제안 보내기 검증: 로그인 필요, 자기 글에는 제안 불가, state=open인 글만, 금액은 예산 이하.
    - 제안 고르기: 글쓴이만 할 수 있다. wanted_posts.picked_offer_id와 state=done만 저장한다. 약속(reservations)·채팅방(chat_rooms) 생성은 이번 범위에서 뺐다(채팅 구현 전). 다시 고르기는 없다.
    - 목록의 별점은 저장하지 않고 reviews에서 seller 기준 평균으로 계산한다.
  '''
}

// ─────────────────────────────────────────────
// 7. 채팅
// ─────────────────────────────────────────────

Table chat_rooms [headerColor: #59627E] {
  id varchar [pk, note: 'push 키']
  product_name varchar [null, ref: > products.name, note: '대화 중인 상품']
  wanted_id varchar [null, ref: > wanted_posts.id, note: '구해요에서 열린 채팅방일 때']
  seller varchar [not null, ref: > users.id, note: '판매자 아이디']
  buyer varchar [not null, ref: > users.id, note: '구매자 아이디']
  last_message varchar [null, note: '마지막 메시지. 채팅방 목록에 보여 준다']
  last_at datetime [null, note: '마지막 메시지 시각. 채팅방 목록 정렬']
  created_at datetime [not null]

  indexes {
    (product_name, buyer) [unique, note: '상품과 구매자 조합마다 채팅방은 하나이다']
    seller
    buyer
  }

  Note: '''
    Firebase 경로: /chat_rooms/{id}

    - 상품 상세의 "판매자와 채팅", 경매 수락 후 "채팅으로 약속 잡기", 구해요 "채팅 열기"에서 생성한다.
    - 이미 같은 상품과 구매자의 채팅방이 있으면 새로 만들지 않고 그 방으로 이동한다.
    - 읽지 않은 메시지 수(unread)는 구현 범위에서 제외한다.
  '''
}

Table chat_messages [headerColor: #59627E] {
  id varchar [pk, note: 'push 키. 시간 순서로 정렬된다']
  room_id varchar [not null, ref: > chat_rooms.id]
  kind message_kind [not null, default: 'user']
  sender varchar [null, ref: > users.id, note: '보낸 사람 아이디. kind=system이면 null']
  text varchar [not null, note: '메시지 내용']
  created_at datetime [not null]

  indexes {
    (room_id, created_at)
  }

  Note: '''
    Firebase 경로: /chat_messages/{room_id}/{id}

    - 실시간 통신 없이 form POST 후 새로 고침 방식으로 구현한다.
    - 메시지를 저장할 때 chat_rooms.last_message, last_at을 함께 갱신한다.
    - 약속 수락, 거절 같은 상태 변화는 kind=system 메시지로 남긴다.
  '''
}

// ─────────────────────────────────────────────
// 그룹
// ─────────────────────────────────────────────

TableGroup member [color: #2B4BF2, note: '필수: 회원가입, 로그인 (소정)'] {
  users
}

TableGroup product [color: #2B4BF2, note: '필수: 상품 등록, 목록, 상세, 찜 (겨레, 찜은 소현)'] {
  products
  product_places
  product_slots
  likes
}

TableGroup review [color: #E8452C, note: '필수: 리뷰 작성, 목록, 상세 (소현)'] {
  reviews
}

TableGroup auction [color: #E8452C, note: '팀 특화: 경매 (겨레)'] {
  auctions
  bids
}

TableGroup wanted [color: #FFB800, note: '팀 특화: 구해요 (소현)'] {
  wanted_posts
  wanted_places
  offers
}

TableGroup deal [color: #59627E, note: '팀 특화: 약속, 채팅 (소정)'] {
  reservations
  chat_rooms
  chat_messages
}

// ─────────────────────────────────────────────
// 메모
// ─────────────────────────────────────────────

Note open_questions {
  '''
  # 회의에서 정할 것

  1. 상품과 리뷰의 키를 상품명으로 할지 push 키로 할지.
     FE 경로(/product/<상품명>, /review/<상품명>)는 상품명 기준이다.
     상품명 키는 금지 문자(. $ # [ ] /)와 상품명 수정 문제가 있다.
  2. 리뷰 작성 조건. 거래 완료 후 구매자만 쓸지, 로그인한 사용자 누구나 쓸지.
  3. 메일 인증 코드(auth_code)를 실제로 발송할지.
  4. 알림(더 높은 제안, 제안 선택 등)은 저장하지 않고 화면 안내 문구만 보여 준다.
  '''
}

Note demo_flow {
  '''
  # 필수 데모에서 바뀌는 노드

  1. A 회원가입: /users/{A}
  2. A 상품 등록: /products/{상품명}
  3. B 리뷰 작성: /reviews/{상품명}
  4. A 리뷰 목록과 상세: 읽기만 한다
  '''
}
